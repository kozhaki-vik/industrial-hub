{
    "name": "industrial-hub",
    "private": false,
    "version": "2.23.22",
    "author": "Kozhaki",
    "license": "MIT",
    "description": "Industrial Hub - Desktop Companion Application",
    "type": "module",
    "main": "electron/main.js",
    "scripts": {
        "dev:vite": "vite",
        "dev:electron": "wait-on tcp:5173 && cross-env NODE_ENV=development electron .",
        "dev": "concurrently -k \"npm run dev:vite\" \"npm run dev:electron\"",
        "compile:native": "node scripts/compile-native.js",
        "build": "npm run compile:native && vite build",
        "lint": "oxlint",
        "preview": "vite preview"
    },
    "dependencies": {
        "dompurify": "^3.4.16",
        "electron-store": "^11.0.2"
    },
    "devDependencies": {
        "@hello-pangea/dnd": "^18.0.1",
        "@tailwindcss/postcss": "^4.3.3",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^6.0.4",
        "autoprefixer": "^10.5.4",
        "concurrently": "^10.0.4",
        "cross-env": "^10.1.0",
        "electron": "^43.2.0",
        "electron-builder": "^26.15.3",
        "i18next": "^26.3.6",
        "lucide-react": "^1.28.0",
        "oxlint": "^1.75.0",
        "postcss": "^8.5.25",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "react-i18next": "^17.0.11",
        "react-router-dom": "^7.18.2",
        "tailwindcss": "^4.3.3",
        "vite": "^8.2.0",
        "wait-on": "^9.1.0"
    },
    "build": {
        "appId": "com.industrialhub.app",
        "productName": "Industrial Hub",
        "copyright": "Copyright © 2026 Dmytro Kondratenko (Kozhaki). Licensed under MIT.",
        "directories": {
            "output": "release"
        },
        "files": [
            "dist/**/*",
            "electron/**/*",
            "package.json"
        ],
        "extraResources": [
            "resources/**/*.exe"
        ],
        "win": {
            "target": [
                "nsis",
                "portable"
            ],
            "icon": "icon256.png"
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true,
            "license": "LICENSE"
        },
        "portable": {}
    }
}
